<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canvas & Simulasi Pos Game: Build the Website</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        code: ['Fira Code', 'monospace']
                    },
                    colors: {
                        tuban: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#035485',
                            800: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex flex-col selection:bg-tuban-500 selection:text-white">

    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-tuban-500 text-white flex items-center justify-center font-bold text-xl shadow-lg shadow-tuban-500/30">
                    🧩
                </div>
                <div>
                    <h1 class="text-lg font-bold text-white leading-tight">Pos Game Canvas: Build the Website</h1>
                    <p class="text-xs text-slate-400">12 Pola Kunci Kelompok, Visual Dinamis & Kunci Jawaban Lengkap</p>
                </div>
            </div>

            <!-- View Switcher Tabs -->
            <div class="flex bg-slate-900/80 p-1 rounded-xl border border-slate-700 text-xs sm:text-sm font-medium">
                <button id="btn-tab-sim" onclick="switchTab('simulation')" class="px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 bg-tuban-500 text-white shadow-sm">
                    <i class="fa-solid fa-gamepad"></i> Simulasi Pos
                </button>
                <button id="btn-tab-key" onclick="openAdminAuthModal()" class="px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition-all flex items-center gap-2">
                    <i class="fa-solid fa-lock text-amber-400"></i> Kunci Jawaban (Admin)
                </button>
                <button id="btn-tab-print" onclick="switchTab('printables')" class="px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition-all flex items-center gap-2">
                    <i class="fa-solid fa-print"></i> Blueprint Cetak
                </button>
            </div>
        </div>
    </header>

    <!-- Admin Modal -->
    <div id="admin-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-sm w-full p-6 shadow-2xl relative space-y-4">
            <button onclick="closeAdminModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="text-center space-y-2">
                <div class="w-12 h-12 bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto text-xl">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="text-lg font-bold text-white">Akses Kunci Jawaban Admin</h3>
                <p class="text-xs text-slate-400">Masukkan PIN Pembimbing Pos untuk membuka matriks 12 kunci jawaban kelompok.</p>
            </div>
            
            <div class="space-y-3">
                <input type="password" id="admin-pin-input" maxlength="6" placeholder="Masukkan PIN Akses" class="w-full bg-slate-900 border border-slate-700 text-center font-code text-xl text-amber-400 tracking-widest rounded-xl py-3 focus:outline-none focus:border-amber-400" onkeyup="if(event.key === 'Enter') submitAdminPin()">
                <div id="admin-pin-error" class="text-xs text-rose-400 text-center hidden">
                    <i class="fa-solid fa-triangle-exclamation"></i> PIN Salah! Akses ditolak.
                </div>
                <button onclick="submitAdminPin()" class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl transition shadow-lg shadow-amber-500/20">
                    Buka Kunci Jawaban
                </button>
            </div>
        </div>
    </div>

    <!-- Game Notification Modal -->
    <div id="game-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl relative space-y-4 text-center">
            <div id="game-modal-icon" class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto text-2xl"></div>
            <h3 id="game-modal-title" class="text-xl font-bold text-white"></h3>
            <p id="game-modal-body" class="text-xs sm:text-sm text-slate-300 leading-relaxed"></p>
            <button onclick="closeGameModal()" class="w-full py-2.5 bg-tuban-500 hover:bg-tuban-600 text-white font-bold text-xs rounded-xl transition">
                Tutup / Lanjutkan
            </button>
        </div>
    </div>

    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

        <!-- TAB 1: SIMULASI INTERAKTIF -->
        <div id="tab-simulation" class="space-y-6">
            
            <!-- Context & Group Selector Banner -->
            <div class="bg-gradient-to-r from-tuban-900/90 via-slate-800 to-slate-800 border border-tuban-500/40 rounded-2xl p-4 sm:p-6 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="p-3 bg-amber-500/20 border border-amber-500/40 rounded-xl text-amber-400 text-2xl shrink-0 mt-1">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 mb-1 flex-wrap">
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">SIMULASI 12 KELOMPOK</span>
                            <span id="group-badge-active" class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-code">Kelompok 1 (Pantai Boom)</span>
                        </div>
                        <h2 class="text-xl font-bold text-white" id="group-theme-title">Website Wisata Tuban Error!</h2>
                        <p class="text-xs sm:text-sm text-slate-300 mt-0.5" id="group-theme-desc">
                            Pasangkan kartu Tag HTML dan Gaya CSS ke dalam slot. Setiap kelompok memiliki pola kode dan visual destinasi yang unik!
                        </p>
                    </div>
                </div>

                <!-- Group Selector Controls -->
                <div class="flex flex-wrap items-center gap-2 shrink-0 w-full lg:w-auto border-t lg:border-t-0 pt-3 lg:pt-0 border-slate-700">
                    <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-700 px-3 py-1.5 rounded-xl text-xs">
                        <label for="group-select" class="text-slate-400 font-semibold shrink-0">Pilih Kelompok:</label>
                        <select id="group-select" onchange="changeGroup(this.value)" class="bg-slate-800 text-amber-300 font-bold border border-slate-600 rounded-lg px-2 py-1 focus:outline-none focus:border-amber-400 cursor-pointer">
                            <option value="1">Kelompok 1 - Pantai Boom</option>
                            <option value="2">Kelompok 2 - Goa Akbar</option>
                            <option value="3">Kelompok 3 - Air Terjun Nglirip</option>
                            <option value="4">Kelompok 4 - Makam Sunan Bonang</option>
                            <option value="5">Kelompok 5 - Kelenteng Kwan Sing Bio</option>
                            <option value="6">Kelompok 6 - Pantai Kelapa</option>
                            <option value="7">Kelompok 7 - Tebing Kapur Rengel</option>
                            <option value="8">Kelompok 8 - Pemandian Bektiharjo</option>
                            <option value="9">Kelompok 9 - Goa Suci Palang</option>
                            <option value="10">Kelompok 10 - Pantai Sowan</option>
                            <option value="11">Kelompok 11 - Museum Kambang Putih</option>
                            <option value="12">Kelompok 12 - Air Terjun Keningar</option>
                        </select>
                    </div>

                    <button onclick="resetSimulation()" class="px-3 py-2 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold transition border border-slate-600 flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate-right"></i> Reset Slot
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Left Column: Guidance & Card Deck (4 Cols) -->
                <div class="lg:col-span-4 space-y-6">
                    
                    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-lg space-y-4">
                        <div class="flex items-center justify-between">
                            <h3 class="font-bold text-white text-sm flex items-center gap-2">
                                <i class="fa-solid fa-layer-group text-tuban-500"></i> Deck Kartu Puzzle Fisik
                            </h3>
                            <span class="text-[10px] bg-tuban-500/20 text-tuban-300 border border-tuban-500/30 px-2 py-0.5 rounded-full font-semibold" id="card-count-badge">Klik Kartu Untuk Memilih</span>
                        </div>
                        <p class="text-xs text-slate-400">Klik kartu di bawah ini, lalu klik tombol <strong>"Pasang Kartu"</strong> pada slot papan landasan. Awas kartu pengecoh!</p>

                        <!-- HTML Cards Section -->
                        <div>
                            <span class="text-[11px] font-bold text-cyan-400 uppercase tracking-wider block mb-2">1. Kartu Tag HTML (Wadah + Isi)</span>
                            <div class="grid grid-cols-1 gap-2" id="deck-html">
                                <!-- JS Generated -->
                            </div>
                        </div>

                        <!-- CSS Cards Section -->
                        <div>
                            <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider block mb-2">2. Kartu Gaya CSS (Tampilan)</span>
                            <div class="grid grid-cols-1 gap-2" id="deck-css">
                                <!-- JS Generated -->
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Middle Column: Layout Board (5 Cols) -->
                <div class="lg:col-span-5 bg-slate-800/90 border border-slate-700 rounded-2xl p-5 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-700">
                            <div>
                                <h3 class="font-bold text-white text-base flex items-center gap-2">
                                    <i class="fa-solid fa-clipboard-list text-amber-400"></i> Papan Landasan Layout
                                </h3>
                                <p class="text-xs text-slate-400">Urutkan dari atas ke bawah sesuai struktur web</p>
                            </div>
                            <button onclick="autoFillCorrect()" class="text-xs text-tuban-400 hover:text-tuban-300 underline font-medium flex items-center gap-1">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-Fill Jawaban
                            </button>
                        </div>

                        <!-- Layout Slots Container -->
                        <div class="space-y-3" id="slots-container">
                            <!-- Slots generated via JS -->
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-700">
                        <div class="bg-slate-900 border border-amber-500/30 rounded-xl p-4 flex flex-col items-center justify-center text-center">
                            <span class="text-xs text-amber-400 uppercase tracking-widest font-bold mb-1">🔐 KODE RAHASIA SERVER KELOMPOK</span>
                            <div class="flex items-center gap-3 my-2" id="secret-code-display">
                                <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                                <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                                <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                                <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                            </div>
                            <p class="text-xs text-slate-400" id="code-hint-status">Susun kartu HTML dengan benar untuk membuka angka di balik kartu!</p>
                            <button id="btn-verify" onclick="checkSolution()" class="mt-3 w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl transition shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2">
                                <i class="fa-solid fa-key"></i> Verifikasi Kode ke Penjaga Pos
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Live Web Preview (3 Cols) -->
                <div class="lg:col-span-3 space-y-6">
                    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-xl">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="font-bold text-white text-sm flex items-center gap-2">
                                <i class="fa-solid fa-desktop text-emerald-400"></i> Live Web Preview
                            </h3>
                            <span id="preview-status" class="inline-flex items-center gap-1.5 text-[10px] bg-rose-500/20 text-rose-300 border border-rose-500/30 px-2 py-0.5 rounded-full font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span> Offline
                            </span>
                        </div>
                        
                        <!-- Simulated Browser Window -->
                        <div class="bg-white text-slate-800 rounded-xl overflow-hidden border border-slate-300 shadow-2xl min-h-[420px] flex flex-col">
                            <!-- Browser Bar -->
                            <div class="bg-slate-200 border-b border-slate-300 px-3 py-1.5 flex items-center gap-2">
                                <div class="flex gap-1">
                                    <div class="w-2.5 h-2.5 rounded-full bg-rose-400"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
                                </div>
                                <div class="bg-white text-[10px] text-slate-500 font-code px-2 py-0.5 rounded flex-1 truncate" id="browser-url">
                                    https://wisata.tubankab.go.id/pantaiboom
                                </div>
                            </div>

                            <!-- Live Browser Canvas Area -->
                            <div id="live-canvas" class="p-4 flex-1 flex flex-col space-y-3 font-sans transition-all duration-300 justify-center">
                                <div id="live-body-status" class="border-2 border-dashed border-slate-300 rounded p-4 flex-1 flex flex-col items-center justify-center text-center">
                                    <i class="fa-solid fa-globe text-slate-300 text-3xl mb-2"></i>
                                    <p class="text-[11px] text-slate-400 italic">
                                        [ Halaman Web Masih Kosong ]<br>Pasang Tag Pembuka & Penutup Body di Slot 1 & 10 untuk mulai merender.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Explanatory Helper Box -->
                    <div class="bg-tuban-900/40 border border-tuban-500/30 rounded-2xl p-4 shadow-lg text-xs space-y-2">
                        <h4 class="font-bold text-tuban-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-info"></i> Info Pola Pos Game:
                        </h4>
                        <p class="text-slate-300 leading-relaxed">
                            • Terdapat <strong>12 Pola Kelompok</strong> unik dengan destinasi khas Tuban.<br>
                            • Angka rahasia tercetak di balik kartu HTML utama: <code>&lt;h1&gt;</code>, <code>&lt;img&gt;</code>, <code>&lt;p&gt;</code>, dan <code>&lt;a&gt;</code>.
                        </p>
                    </div>
                </div>

            </div>
        </div>

        <!-- TAB 2: KUNCI JAWABAN (ADMIN) -->
        <div id="tab-answerkey" class="hidden space-y-8">
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 max-w-5xl mx-auto space-y-3 text-center">
                <span class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs px-3 py-1 rounded-full font-semibold">MATRIKS KUNCI JAWABAN PEMBIMBING POS</span>
                <h2 class="text-2xl font-extrabold text-white">💡 Kunci Jawaban Lengkap (12 Kelompok)</h2>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-3xl mx-auto">
                    Tabel matriks di bawah ini memuat seluruh kode rahasia 4-digit beserta destinasi wisata visual untuk ke-12 kelompok peserta.
                </p>
            </div>

            <!-- 12 Group Master Matrix Table -->
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 max-w-5xl mx-auto shadow-2xl overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-200">
                    <thead class="bg-slate-900 text-amber-400 font-bold border-b border-slate-700 uppercase tracking-wider">
                        <tr>
                            <th class="p-3">Kelompok</th>
                            <th class="p-3">Destinasi Wisata</th>
                            <th class="p-3">Pola Kode (4-Digit)</th>
                            <th class="p-3">Elemen HTML Utama (H1, IMG, P, A)</th>
                            <th class="p-3 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700 font-sans" id="matrix-table-body">
                        <!-- JS Generated Matrix -->
                    </tbody>
                </table>
            </div>

            <div class="bg-slate-800 border-2 border-amber-500/40 rounded-2xl p-6 max-w-5xl mx-auto shadow-2xl space-y-6" id="dynamic-answer-key-content">
                <!-- JS Generated Detailed Single Group View -->
            </div>
        </div>

        <!-- TAB 3: BLUEPRINT CETAK -->
        <div id="tab-printables" class="hidden space-y-8">
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 text-center max-w-3xl mx-auto space-y-2">
                <span class="bg-tuban-500/20 text-tuban-300 border border-tuban-500/30 text-xs px-3 py-1 rounded-full font-semibold">LEMBAR CETAK FISIK POS</span>
                <h2 class="text-2xl font-bold text-white">Desain Fisik Siap Cetak (Printable Blueprint)</h2>
                <p class="text-xs sm:text-sm text-slate-300">Gunakan tata letak berikut untuk mencetak Papan Landasan (Ukuran A3/A4) dan Lembar Kartu Puzzle.</p>
            </div>

            <!-- Printable Board Blueprint -->
            <div class="bg-white text-slate-900 rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto shadow-2xl border-4 border-slate-300">
                <div class="border-2 border-slate-900 p-6 space-y-6">
                    <div class="text-center border-b-2 border-slate-900 pb-4">
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-500">PAPAN LANDASAN LAYOUT (PRINTABLE A3 / A4)</span>
                        <h1 class="text-2xl font-extrabold text-slate-900 uppercase tracking-tight">BUILD THE WEBSITE — WISATA TUBAN</h1>
                    </div>

                    <div class="space-y-3 font-code text-xs">
                        <div class="border-2 border-dashed border-slate-400 p-2.5 bg-slate-50 text-center font-bold text-slate-600">
                            [ SLOT 1: Tag Pembuka Utama Website ]
                        </div>
                        <div class="border-2 border-slate-800 p-3 space-y-2">
                            <div class="border-2 border-dashed border-cyan-600 p-2 bg-cyan-50 font-bold text-cyan-800 text-center">
                                [ SLOT 2: Elemen Judul Utama Wisata ]
                            </div>
                            <div class="border-2 border-dashed border-emerald-600 p-2 bg-emerald-50 font-bold text-emerald-800 text-center">
                                [ SLOT 3: Gaya CSS Judul Utama ]
                            </div>
                        </div>
                        <div class="border-2 border-slate-800 p-3 space-y-2">
                            <div class="border-2 border-dashed border-cyan-600 p-2 bg-cyan-50 font-bold text-cyan-800 text-center">
                                [ SLOT 4: Elemen Foto / Gambar Wisata ]
                            </div>
                            <div class="border-2 border-dashed border-emerald-600 p-2 bg-emerald-50 font-bold text-emerald-800 text-center">
                                [ SLOT 5: Gaya CSS Gambar Wisata ]
                            </div>
                        </div>
                        <div class="border-2 border-slate-800 p-3 space-y-2">
                            <div class="border-2 border-dashed border-cyan-600 p-2 bg-cyan-50 font-bold text-cyan-800 text-center">
                                [ SLOT 6: Elemen Teks Deskripsi Wisata ]
                            </div>
                            <div class="border-2 border-dashed border-emerald-600 p-2 bg-emerald-50 font-bold text-emerald-800 text-center">
                                [ SLOT 7: Gaya CSS Teks Deskripsi ]
                            </div>
                        </div>
                        <div class="border-2 border-slate-800 p-3 space-y-2">
                            <div class="border-2 border-dashed border-cyan-600 p-2 bg-cyan-50 font-bold text-cyan-800 text-center">
                                [ SLOT 8: Elemen Tombol Tautan Aksi ]
                            </div>
                            <div class="border-2 border-dashed border-emerald-600 p-2 bg-emerald-50 font-bold text-emerald-800 text-center">
                                [ SLOT 9: Gaya CSS Tombol Tautan ]
                            </div>
                        </div>
                        <div class="border-2 border-dashed border-slate-400 p-2.5 bg-slate-50 text-center font-bold text-slate-600">
                            [ SLOT 10: Tag Penutup Utama Website ]
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Pos Interactive Game — Modul Wisata Tuban Website Builder • Media Edukasi Berbasis Game
    </footer>

