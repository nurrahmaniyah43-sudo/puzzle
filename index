                if (card.type === 'html') htmlDeck.appendChild(cardEl);
                else if (card.type === 'css') cssDeck.appendChild(cardEl);
            });

            const countBadge = document.getElementById('card-count-badge');
            if (activeSelectedCard) {
                const selectedCardObj = CARDS.find(c => c.id === activeSelectedCard);
                countBadge.innerText = `Terpilih: ${selectedCardObj.label}`;
                countBadge.className = "text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded-full font-semibold truncate max-w-[150px]";
