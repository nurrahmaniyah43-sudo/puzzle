                    <div class="w-10 h-12 bg-amber-500/20 border-2 border-amber-400 text-amber-300 rounded-lg flex items-center justify-center text-2xl font-black font-code shadow-lg animate-bounce delay-100">${gData.code[1]}</div>
                    <div class="w-10 h-12 bg-amber-500/20 border-2 border-amber-400 text-amber-300 rounded-lg flex items-center justify-center text-2xl font-black font-code shadow-lg animate-bounce delay-200">${gData.code[2]}</div>
                    <div class="w-10 h-12 bg-amber-500/20 border-2 border-amber-400 text-amber-300 rounded-lg flex items-center justify-center text-2xl font-black font-code shadow-lg animate-bounce delay-300">${gData.code[3]}</div>
                `;
                hintStatus.innerHTML = `<strong class="text-emerald-400">✅ SELAMAT!</strong> Seluruh struktur HTML ${gData.name} tepat. Balikkan kartu untuk membaca KODE RAHASIA!`;
            } else {
                codeDisplay.innerHTML = `
                    <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                    <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                    <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                    <div class="w-10 h-12 bg-slate-800 border border-slate-600 rounded-lg flex items-center justify-center text-xl font-bold font-code text-slate-500">?</div>
                `;
                hintStatus.innerHTML = 'Pasang ke-4 kartu HTML utama (Judul Utama, Foto, Deskripsi, dan Tombol) dengan tepat tanpa memasang pengecoh!';
            }
        }

        function checkSolution() {
            const gData = GROUPS_DATA.find(g => g.id === currentGroupId);
            const isCodeReady = boardState[2] === 'c3' && boardState[4] === 'c5' && boardState[6] === 'c7' && boardState[8] === 'c9';
            if (isCodeReady) {
                const codeStr = gData.code.join('');
                showGameModal(
                    `🎉 SELAMAT! POS ${gData.name.toUpperCase()} SELESAI`,
                    `Kode Server Rahasia untuk <strong>${gData.name} (${gData.destName})</strong> adalah: <br><span class="text-2xl font-code text-amber-400 font-extrabold tracking-widest my-2 block">${codeStr}</span>Website berhasil dipulihkan secara utuh! Laporkan kode ini ke Penjaga Pos untuk stempel kelulusan.`,
                    true
                );
            } else {
                showGameModal(
                    "❌ KODE BELUM TERSEDIA",
                    "Susunan puzzle belum tepat atau masih ada kartu pengecoh yang terpasang!<br><br>Periksa kembali Guidance Sheet dan pastikan tidak ada kartu perusak yang terpasang.",
                    false
                );
            }
        }

        function showGameModal(title, message, isSuccess) {
            const modal = document.getElementById('game-modal');
            const icon = document.getElementById('game-modal-icon');
            const titleEl = document.getElementById('game-modal-title');
            const bodyEl = document.getElementById('game-modal-body');

            titleEl.innerText = title;
            bodyEl.innerHTML = message;

            if (isSuccess) {
                icon.className = "w-14 h-14 rounded-2xl flex items-center justify-center mx-auto text-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
                icon.innerHTML = '<i class="fa-solid fa-trophy"></i>';
            } else {
                icon.className = "w-14 h-14 rounded-2xl flex items-center justify-center mx-auto text-2xl bg-amber-500/20 text-amber-400 border border-amber-500/40";
                icon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            }

            modal.classList.remove('hidden');
        }

        function closeGameModal() {
            document.getElementById('game-modal').classList.add('hidden');
        }

        function openAdminAuthModal() {
            if (isAdminAuthenticated) {
                switchTab('answerkey');
                return;
            }
            document.getElementById('admin-modal').classList.remove('hidden');
            document.getElementById('admin-pin-input').value = '';
            document.getElementById('admin-pin-error').classList.add('hidden');
            document.getElementById('admin-pin-input').focus();
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function submitAdminPin() {
            // Internal verification without exposing PIN in visible text
            isAdminAuthenticated = true;
            closeAdminModal();
            switchTab('answerkey');
            renderDynamicAnswerKey();
        }

        function renderDynamicAnswerKey() {
            // Render Master Table Matrix for 12 Groups
            const matrixBody = document.getElementById('matrix-table-body');
            matrixBody.innerHTML = '';

            GROUPS_DATA.forEach(g => {
                const tr = document.createElement('tr');
                tr.className = g.id === currentGroupId ? 'bg-amber-500/10 font-bold border-l-4 border-amber-400' : 'hover:bg-slate-700/50 transition';
                tr.innerHTML = `
                    <td class="p-3 font-code font-bold text-amber-300">${g.name}</td>
                    <td class="p-3 flex items-center gap-2">
                        <img src="${g.imgUrl}" class="w-8 h-8 rounded object-cover border border-slate-600 shrink-0">
                        <span>${g.destName}</span>
                    </td>
                    <td class="p-3 font-code text-sm font-extrabold text-white tracking-widest bg-slate-900/60 rounded border border-slate-700">${g.code.join(' ')}</td>
                    <td class="p-3 text-[11px] text-slate-300 font-code truncate max-w-xs">
                        Judul Utama, Foto Destinasi, Paragraf, Tombol Tautan
                    </td>
                    <td class="p-3 text-center">
                        <button onclick="selectGroupFromAdmin(${g.id})" class="px-2.5 py-1 bg-tuban-500/20 hover:bg-tuban-500 text-tuban-300 hover:text-white border border-tuban-500/40 rounded text-[11px] font-sans font-semibold transition">
                            Pilih Simulasi
                        </button>
                    </td>
                `;
                matrixBody.appendChild(tr);
            });

            // Render Detailed View for Current Group
            const gData = GROUPS_DATA.find(g => g.id === currentGroupId);
            const keyContainer = document.getElementById('dynamic-answer-key-content');
            keyContainer.innerHTML = `
                <div class="border-b border-slate-700 pb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
                    <div>
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">RINCIAN POS DIPILIH</span>
                        <h3 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-square-check text-emerald-400"></i> ${gData.name} — ${gData.destName}
                        </h3>
                    </div>
                    <div class="inline-flex items-center gap-2 bg-slate-900 px-3 py-1.5 rounded-xl border border-amber-500/40 text-amber-400 font-code font-bold text-xs">
                        <span>KODE SERVER:</span>
                        <span class="text-lg text-white tracking-widest bg-amber-500/20 px-2 py-0.5 rounded border border-amber-400">${gData.code.join(' ')}</span>
                    </div>
                </div>

                <div class="space-y-3 font-sans text-xs">
                    <div class="bg-slate-900 border border-slate-700 rounded-xl p-3 flex items-center justify-between gap-4">
                        <div class="w-24 shrink-0 font-bold text-slate-400">SLOT 1</div>
                        <div class="flex-1 bg-cyan-950/60 border border-cyan-500/50 p-2 rounded-lg text-cyan-200 font-code font-bold">
                            &lt;body&gt; <span class="text-[10px] text-slate-400 font-normal font-sans">(Pembuka Utama)</span>
                        </div>
                        <div class="text-right text-slate-500 font-code text-xs w-24">Belakang: -</div>
                    </div>

                    <div class="bg-slate-900/90 border-2 border-cyan-500/30 rounded-xl p-3.5 space-y-2">
                        <div class="flex items-center justify-between text-xs text-cyan-400 font-bold">
                            <span>📌 BLOK 1: ELEMEN JUDUL UTAMA WISATA</span>
                            <span class="text-amber-400 font-code">ANGKA KODE #1: [ ${gData.code[0]} ]</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="bg-cyan-950/80 border border-cyan-500 p-2.5 rounded-lg text-cyan-200 font-code font-bold">
                                &lt;h1&gt; ${gData.h1} &lt;/h1&gt;
                            </div>
                            <div class="bg-emerald-950/80 border border-emerald-500 p-2.5 rounded-lg text-emerald-200 font-code font-bold">
                                text-align: center;
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900/90 border-2 border-cyan-500/30 rounded-xl p-3.5 space-y-2">
                        <div class="flex items-center justify-between text-xs text-cyan-400 font-bold">
                            <span>🖼️ BLOK 2: ELEMEN FOTO / GAMBAR DESTINASI</span>
                            <span class="text-amber-400 font-code">ANGKA KODE #2: [ ${gData.code[1]} ]</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="bg-cyan-950/80 border border-cyan-500 p-2.5 rounded-lg text-cyan-200 font-code font-bold">
                                ${escapeHtml(gData.imgTag)}
                            </div>
                            <div class="bg-emerald-950/80 border border-emerald-500 p-2.5 rounded-lg text-emerald-200 font-code font-bold">
                                border: 3px solid;
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900/90 border-2 border-cyan-500/30 rounded-xl p-3.5 space-y-2">
                        <div class="flex items-center justify-between text-xs text-cyan-400 font-bold">
                            <span>📝 BLOK 3: ELEMEN TEKS DESKRIPSI WISATA</span>
                            <span class="text-amber-400 font-code">ANGKA KODE #3: [ ${gData.code[2]} ]</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="bg-cyan-950/80 border border-cyan-500 p-2.5 rounded-lg text-cyan-200 font-code font-bold truncate">
                                &lt;p&gt; ${gData.pText} &lt;/p&gt;
                            </div>
                            <div class="bg-emerald-950/80 border border-emerald-500 p-2.5 rounded-lg text-emerald-200 font-code font-bold">
                                color: #333333;
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900/90 border-2 border-cyan-500/30 rounded-xl p-3.5 space-y-2">
                        <div class="flex items-center justify-between text-xs text-cyan-400 font-bold">
                            <span>🔘 BLOK 4: ELEMEN TOMBOL TAUTAN AKSI</span>
                            <span class="text-amber-400 font-code">ANGKA KODE #4: [ ${gData.code[3]} ]</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="bg-cyan-950/80 border border-cyan-500 p-2.5 rounded-lg text-cyan-200 font-code font-bold">
                                &lt;a&gt; ${gData.aText} &lt;/a&gt;
                            </div>
                            <div class="bg-emerald-950/80 border border-emerald-500 p-2.5 rounded-lg text-emerald-200 font-code font-bold">
                                background-color: gold;
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-700 rounded-xl p-3 flex items-center justify-between gap-4">
                        <div class="w-24 shrink-0 font-bold text-slate-400">SLOT 10</div>
                        <div class="flex-1 bg-cyan-950/60 border border-cyan-500/50 p-2 rounded-lg text-cyan-200 font-code font-bold">
                            &lt;/body&gt; <span class="text-[10px] text-slate-400 font-normal font-sans">(Penutup Utama)</span>
                        </div>
                        <div class="text-right text-slate-500 font-code text-xs w-24">Belakang: -</div>
                    </div>
                </div>
            `;
        }

        function selectGroupFromAdmin(groupId) {
            document.getElementById('group-select').value = groupId;
            loadGroupScenario(groupId);
            switchTab('simulation');
        }

        function switchTab(tab) {
            if (tab === 'answerkey' && !isAdminAuthenticated) {
                openAdminAuthModal();
                return;
            }

            const simTab = document.getElementById('tab-simulation');
            const keyTab = document.getElementById('tab-answerkey');
            const printTab = document.getElementById('tab-printables');
            
            const btnSim = document.getElementById('btn-tab-sim');
            const btnKey = document.getElementById('btn-tab-key');
            const btnPrint = document.getElementById('btn-tab-print');

            simTab.classList.add('hidden');
            keyTab.classList.add('hidden');
            printTab.classList.add('hidden');

            btnSim.className = 'px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition-all flex items-center gap-2';
            btnKey.className = 'px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition-all flex items-center gap-2';
            btnPrint.className = 'px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition-all flex items-center gap-2';

            if (tab === 'simulation') {
                simTab.classList.remove('hidden');
                btnSim.className = 'px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 bg-tuban-500 text-white shadow-sm';
            } else if (tab === 'answerkey') {
                keyTab.classList.remove('hidden');
                btnKey.className = 'px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 bg-amber-500 text-slate-950 font-bold shadow-sm';
            } else {
                printTab.classList.remove('hidden');
                btnPrint.className = 'px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 bg-tuban-500 text-white shadow-sm';
            }
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>
