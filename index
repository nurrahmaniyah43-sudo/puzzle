        function renderSlots() {
            const container = document.getElementById('slots-container');
            container.innerHTML = '';

            SLOTS.forEach(slot => {
                const placedCardId = boardState[slot.id];
                const card = CARDS.find(c => c.id === placedCardId);

                const slotEl = document.createElement('div');
                slotEl.className = "bg-slate-900/80 border border-slate-700 rounded-xl p-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3";

