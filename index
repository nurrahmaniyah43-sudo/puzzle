        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }

        function renderDeck() {
            const htmlDeck = document.getElementById('deck-html');
            const cssDeck = document.getElementById('deck-css');

            htmlDeck.innerHTML = '';
            cssDeck.innerHTML = '';

            CARDS.forEach(card => {
                const isPlaced = Object.values(boardState).includes(card.id);
                if (isPlaced) return;

                const isSelected = activeSelectedCard === card.id;

                const cardEl = document.createElement('div');
                cardEl.onclick = () => selectCard(card.id);

                let badgeColor = card.type === 'html' ? 'bg-cyan-600' : 'bg-emerald-600';
                let borderColor = isSelected ? 'border-amber-400 ring-2 ring-amber-400' : 'border-slate-700 hover:border-slate-500';
                let bgColor = isSelected ? 'bg-slate-700' : 'bg-slate-900';

                cardEl.className = `p-2.5 rounded-xl border ${borderColor} ${bgColor} cursor-pointer transition flex items-center justify-between text-xs group`;
