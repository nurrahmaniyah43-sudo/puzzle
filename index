        function updateLivePreview() {
            const canvas = document.getElementById('live-canvas');
            const previewStatus = document.getElementById('preview-status');
            const gData = GROUPS_DATA.find(g => g.id === currentGroupId);

            const hasBodyOpening = boardState[1] === 'c1';
            const hasBodyClosing = boardState[10] === 'c2';

            const usedCards = Object.values(boardState).map(id => CARDS.find(c => c.id === id));
            const hasFatalDistractor = usedCards.some(c => c && c.isDistractor);

            if (hasFatalDistractor) {
                canvas.innerHTML = `
                    <div class="border-2 border-dashed border-rose-400 bg-rose-950/20 rounded p-6 flex-1 flex flex-col items-center justify-center text-center space-y-2">
